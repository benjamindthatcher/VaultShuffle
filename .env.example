# Public application configuration
NEXT_PUBLIC_SITE_URL=http://localhost:8766
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Server-only Supabase and session secrets
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
SESSION_SECRET=replace_with_a_long_random_value

# Steam integration
STEAM_WEB_API_KEY=your_steam_web_api_key

# Protected background workers
CRON_SECRET=replace_with_a_long_random_value
CATALOGUE_INGEST_SECRET=replace_with_a_long_random_value
IGDB_CLIENT_ID=your_igdb_client_id
IGDB_CLIENT_SECRET=your_igdb_client_secret

# Optional PostHog product analytics
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=your_posthog_project_token
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Optional support email delivery
RESEND_API_KEY=your_resend_api_key
SUPPORT_FROM_EMAIL="VaultShuffle <support@your-domain.example>"
SUPPORT_INBOX_EMAIL=support@your-domain.example

# Optional search-engine verification
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
