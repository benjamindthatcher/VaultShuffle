{
  "name": "vaultshuffle-redesign",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -p 8766",
    "build": "next build",
    "start": "next start -p 8766",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm test && npm run build",
    "test": "node --experimental-strip-types --test lib/*.test.ts supabase/functions/_shared/igdb-duration-provider.test.ts",
    "catalogue:fetch-top": "node scripts/catalogue/fetch-steamspy-top.mjs",
    "catalogue:build-seed": "node scripts/catalogue/build-seed-sql.mjs",
    "catalogue:import-durations": "node scripts/catalogue/import-duration-estimates.mjs",
    "igdb:lookup": "node --experimental-strip-types scripts/igdb/lookup.ts",
    "duration:admin": "node --experimental-strip-types scripts/igdb/admin.ts",
    "duration:hltb": "python3 scripts/durations/enrich-hltb.py",
    "test:duration": "node --experimental-strip-types --test supabase/functions/_shared/igdb-duration-provider.test.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.4",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "next": "^16.3.0",
    "posthog-js": "^1.416.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "typescript": "^5.9.2"
  },
  "overrides": {
    "dompurify": "^3.4.13",
    "postcss": "^8.5.26"
  }
}
